# Ignore environment variables in both frontend and backend
frontend/wood_product/.env
backend/.env

# Optional: ignore any other env files at root or anywhere
.env

# Node.js dependencies
node_modules/

# Build output folders
dist/
build/
out/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE/editor folders and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Optional: coverage folder if you use testing tools
coverage/

# Optional: lock files for package managers (ignore if you want to track them)
# package-lock.json
# yarn.lock
